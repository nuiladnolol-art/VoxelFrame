<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Voxalith.Launcher</RootNamespace>
    <AssemblyName>Voxalith.Launcher</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <CodePage>65001</CodePage>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Voxalith.Shared\PackageSecurity.cs" Link="PackageSecurity.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Voxalith.Game</RootNamespace>
    <AssemblyName>Voxalith</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodePage>65001</CodePage>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Voxalith.Core\Voxalith.Core.csproj" />
    <PackageReference Include="Raylib-cs" Version="7.0.0" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyNativeRaylib" AfterTargets="Build">
    <PropertyGroup>
      <_NativeRaylibFromOutput>$(TargetDir)runtimes\win-x64\native\raylib.dll</_NativeRaylibFromOutput>
      <_NativeRaylibFromPkg>$(PkgRaylib_cs)\runtimes\win-x64\native\raylib.dll</_NativeRaylibFromPkg>
    </PropertyGroup>
    <Copy SourceFiles="$(_NativeRaylibFromOutput)"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(_NativeRaylibFromOutput)') and !Exists('$(TargetDir)raylib.dll')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_NativeRaylibFromPkg)"
          DestinationFolder="$(TargetDir)"
          Condition="!Exists('$(TargetDir)raylib.dll') and Exists('$(_NativeRaylibFromPkg)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
